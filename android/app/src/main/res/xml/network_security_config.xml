<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed because the user can pick it for a server. NSH's capabilities and the app's own checks decide what is used. Certificates come from the system store only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

# Release signing settings for scripts/build-release.sh. Copy this to
# ~/.config/amp-mobile/release.env (preferred: outside the repository), or to .env.release
# here (git ignores it), put the key's password in, and make it private:
#
#   mkdir -p ~/.config/amp-mobile
#   cp release.env.example ~/.config/amp-mobile/release.env
#   chmod 600 ~/.config/amp-mobile/release.env
#
# Anyone who can read the file can sign updates as you: keep it out of backups you share.
AMP_KEYSTORE_PASSWORD=
# Optional; these are the defaults.
# AMP_RELEASE_KEYSTORE=/home/you/.android/amp-mobile-release.jks
# AMP_RELEASE_ALIAS=amp-mobile

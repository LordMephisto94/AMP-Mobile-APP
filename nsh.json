{
  "name": "AMP Mobile",
  "id": "com.meganet.AMP3App",
  "version": "0.5.3",
  "build": 27,
  "icon": "assets/icon.png",
  "theme": "theme.json",
  "appearance": "dark",
  "statusBar": {
    "foreground": "light"
  },
  "capabilities": {
    "network": {
      "http": [
        {
          "host": "*",
          "schemes": [
            "https",
            "wss"
          ]
        },
        {
          "host": "*",
          "schemes": [
            "http",
            "ws"
          ]
        }
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    },
    "clipboard": true,
    "picker": true,
    "statusBar": true,
    "host": [
      "deviceKey.*",
      "crashWatch.*"
    ]
  }
}

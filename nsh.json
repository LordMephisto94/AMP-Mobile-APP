{
  "name": "AMP Mobile",
  "id": "com.meganet.ampmobile",
  "version": "0.1.10",
  "build": 11,
  "icon": "assets/icon.png",
  "theme": "theme.json",
  "appearance": "dark",
  "statusBar": {
    "foreground": "light"
  },
  "capabilities": {
    "network": {
      "http": [
        {
          "host": "*",
          "schemes": [
            "https",
            "wss"
          ]
        }
      ]
    },
    "openUrl": {
      "schemes": [
        "https"
      ]
    },
    "clipboard": true,
    "picker": true,
    "statusBar": true
  },
  "rust": "native"
}
